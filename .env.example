# Copier en .env (ou définir ces variables dans le service système) pour la production.
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=exemple.ci,www.exemple.ci
DJANGO_CSRF_TRUSTED_ORIGINS=https://exemple.ci,https://www.exemple.ci
DJANGO_ADMIN_URL=un-chemin-admin-difficile-a-deviner/
SITE_NAME=Yere
SITE_URL=https://exemple.ci
# SQLITE_PATH=/srv/yere/var/db.sqlite3
# MEDIA_ROOT=/srv/yere/media
# BACKUP_DIR=/srv/backups/yere
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemple.ci
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@exemple.ci
